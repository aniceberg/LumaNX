+// BFTTF firmware payloads use a per-word XOR (0x06186249 in host byte
+// order). Keep a decoded private allocation with the same 8-byte SDK header;
+// never modify the imported resources. The file's length and SFNT magic are
+// checked before handing a font to guest code.
+static font_t font_bfttf_map(const char *path) {
+    int fd = open(path, O_RDONLY); struct stat st;
+    if (fd < 0) return (font_t){0};
+    if (fstat(fd, &st) || st.st_size < 12 || st.st_size > (64 << 20) || (st.st_size & 3)) { close(fd); return (font_t){0}; }
+    size_t n = (size_t)st.st_size;
+    uint8_t *m = mmap(NULL, n, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (m == MAP_FAILED) { close(fd); return (font_t){0}; }
+    size_t got = 0;
+    while (got < n) { ssize_t r = pread(fd, m + got, n - got, (off_t)got); if (r <= 0) break; got += (size_t)r; }
+    close(fd);
+    uint32_t magic = 0, length = 0;
+    if (got == n) { memcpy(&magic, m, 4); memcpy(&length, m + 4, 4); }
+    if (got != n || (magic ^ 0x06186249u) != 0x18029a7fu || __builtin_bswap32(length ^ 0x06186249u) != n - 8) goto invalid;
+    for (size_t i = 8; i < n; i += 4) { uint32_t word; memcpy(&word, m + i, 4); word ^= 0x06186249u; memcpy(m + i, &word, 4); }
+    if (memcmp(m + 8, "\0\1\0\0", 4) && memcmp(m + 8, "OTTO", 4) && memcmp(m + 8, "ttcf", 4)) goto invalid;
+    magic = 0x18029a7fu; memcpy(m, &magic, 4);
+    return (font_t){m, n};
+invalid:
+    LOG("[RED] invalid firmware shared font: %s", path); munmap(m, n); return (font_t){0};
+}
