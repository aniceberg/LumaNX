+static DmNextendoAsync *new_request(void) { DmNextendoAsync *state = [DmNextendoAsync new]; state.lock = [NSLock new]; state.events = [NSMutableArray new]; state.result = DM_ACCOUNT_FAIL; return state; }
+static void finish_events(NSArray<NSNumber *> *events) { for (NSNumber *binding in events) hle_signal_system_event_binding(binding.unsignedLongLongValue); }
+static void destroy_request(DmNextendoAsync *state) { if (!state) return; [state.lock lock]; state.destroyed = YES; state.generation++; state.done = YES; state.result = DM_ACCOUNT_FAIL; NSArray *events = state.events.copy; [state.lock unlock]; finish_events(events); }
+void dm_nextendo_async_construct(void *object) { @autoreleasepool {
+    if (!object) return; DmNextendoAsync *state = new_request(); if (!state) return; pthread_once(&requestsOnce, requests_init); pthread_mutex_lock(&requestsLock);
+    DmNextendoAsync *old = requests[request_key(object)]; if (requests.count < 512 || old) { state.lifetime = ++nextLifetime; requests[request_key(object)] = state; } pthread_mutex_unlock(&requestsLock); destroy_request(old);
+} }
+void dm_nextendo_async_destroy(void *object) { @autoreleasepool { if (!object) return; pthread_once(&requestsOnce, requests_init); pthread_mutex_lock(&requestsLock); DmNextendoAsync *state = requests[request_key(object)]; [requests removeObjectForKey:request_key(object)]; pthread_mutex_unlock(&requestsLock); destroy_request(state); } }
+void *dm_nextendo_async_move(void *object, void *source) { @autoreleasepool {
+    if (!object || !source || object == source) return object; pthread_once(&requestsOnce, requests_init); pthread_mutex_lock(&requestsLock);
+    DmNextendoAsync *old = requests[request_key(object)], *state = requests[request_key(source)]; [requests removeObjectForKey:request_key(source)]; requests[request_key(object)] = state; pthread_mutex_unlock(&requestsLock); destroy_request(old); return object;
+} }
+void dm_nextendo_async_swap(void *object, void *other) { @autoreleasepool {
+    if (!object || !other || object == other) return; pthread_once(&requestsOnce, requests_init); pthread_mutex_lock(&requestsLock); DmNextendoAsync *first = requests[request_key(object)], *second = requests[request_key(other)]; requests[request_key(object)] = second; requests[request_key(other)] = first; pthread_mutex_unlock(&requestsLock);
+} }
+bool dm_nextendo_async_valid(void *object) { @autoreleasepool { DmNextendoAsync *state = request(object); if (!state) return false; [state.lock lock]; bool valid = state.started && !state.destroyed; [state.lock unlock]; return valid; } }
+uint64_t dm_nextendo_async_lifetime(void *object) { @autoreleasepool { DmNextendoAsync *state = request(object); if (!state) return 0; [state.lock lock]; uint64_t id = state.started && !state.destroyed ? state.lifetime : 0; [state.lock unlock]; return id; } }
+uint32_t dm_nextendo_async_attach(void *object, uint64_t lifetime, uint64_t binding) { @autoreleasepool {
+    if (!object || !lifetime || !binding) return DM_ACCOUNT_FAIL; DmNextendoAsync *state = request(object); if (!state) return DM_ACCOUNT_FAIL; [state.lock lock];
+    if (state.lifetime != lifetime || state.destroyed || !state.started || state.events.count >= 64) { [state.lock unlock]; return DM_ACCOUNT_FAIL; }
+    if (![state.events containsObject:@(binding)]) [state.events addObject:@(binding)]; BOOL done = state.done; [state.lock unlock]; if (done) hle_signal_system_event_binding(binding); return 0;
+} }
+uint32_t dm_nextendo_async_execute(void *object, dm_nextendo_async_operation operation, const void *context) { @autoreleasepool {
+    if (!object || !operation || !enabled()) return DM_ACCOUNT_FAIL;
+    DmNextendoAsync *state = request(object); if (!state) { dm_nextendo_async_construct(object); state = request(object); } if (!state) return DM_ACCOUNT_FAIL;
+    [state.lock lock]; BOOL replacing = state.started && state.done && !state.destroyed; [state.lock unlock];
+    if (replacing) {
+        DmNextendoAsync *fresh = new_request(); if (!fresh) return DM_ACCOUNT_FAIL;
+        pthread_mutex_lock(&requestsLock); if (requests[request_key(object)] != state) { pthread_mutex_unlock(&requestsLock); return DM_ACCOUNT_FAIL; }
+        fresh.lifetime = ++nextLifetime; requests[request_key(object)] = fresh; pthread_mutex_unlock(&requestsLock); destroy_request(state); state = fresh;
+    }
+    [state.lock lock]; if (state.started || state.destroyed) { [state.lock unlock]; return DM_ACCOUNT_FAIL; } state.started = YES; uint64_t generation = ++state.generation; [state.lock unlock];
+    uint32_t result = operation(context);
+    [state.lock lock]; NSArray *events = nil; if (!state.destroyed && state.generation == generation) { state.result = result; state.done = YES; events = state.events.copy; } [state.lock unlock]; finish_events(events);
+    return enabled() ? 0 : DM_ACCOUNT_FAIL;
+} }
+static uint32_t ensure_token_operation(const void *context) {
+    (void)context; DmNextendoCredential *c = credential();
+    if (!c) return credential_return(DM_ACCOUNT_RETURN_ASYNC_ENSURE,DM_ACCOUNT_FAIL);
+    return dm_account_trace_return(DM_ACCOUNT_RETURN_ASYNC_ENSURE,id_token(c) ? 0 : DM_ACCOUNT_FAIL,DM_ACCOUNT_STAGE_ID_TOKEN);
+}
+uint32_t dm_nextendo_async_ensure(void *object) { return dm_account_trace_return(DM_ACCOUNT_RETURN_ASYNC_ENSURE,dm_nextendo_async_execute(object, ensure_token_operation, NULL),DM_ACCOUNT_STAGE_ASYNC_SETUP); }
+uint32_t dm_nextendo_async_cancel(void *object) { @autoreleasepool {
+    DmNextendoAsync *state = request(object); if (!state) return DM_ACCOUNT_FAIL; [state.lock lock]; if (!state.started || state.destroyed) { [state.lock unlock]; return DM_ACCOUNT_FAIL; }
+    NSArray *events = nil; if (!state.done) { state.generation++; state.done = YES; state.result = DM_ACCOUNT_FAIL; events = state.events.copy; } [state.lock unlock]; finish_events(events); return 0;
+} }
+uint32_t dm_nextendo_async_done(void *object, uint8_t *out) { @autoreleasepool {
+    if (!out) return DM_ACCOUNT_FAIL; *out = 0; DmNextendoAsync *state = request(object); if (!state) return DM_ACCOUNT_FAIL; [state.lock lock]; uint32_t result = !state.started || state.destroyed ? DM_ACCOUNT_FAIL : 0; if (!result) *out = state.done; [state.lock unlock]; return result;
+} }
+uint32_t dm_nextendo_async_result(void *object) { @autoreleasepool {
+    DmNextendoAsync *state = request(object); if (!state) return dm_account_trace_return(DM_ACCOUNT_RETURN_ASYNC_RESULT,DM_ACCOUNT_FAIL,DM_ACCOUNT_STAGE_ASYNC_CONTEXT);
+    [state.lock lock]; BOOL completed = state.started && state.done && !state.destroyed;
+    uint32_t result = completed ? state.result : DM_ACCOUNT_FAIL; [state.lock unlock];
+    return dm_account_trace_return(DM_ACCOUNT_RETURN_ASYNC_RESULT,result,completed ? DM_ACCOUNT_STAGE_ASYNC_COMPLETION : DM_ACCOUNT_STAGE_ASYNC_STATE);
+} }
diff --git a/dm/host/hle_nextendo_friends.c b/dm/host/hle_nextendo_friends.c
new file mode 100644
index 0000000..8386141
--- /dev/null
+++ b/dm/host/hle_nextendo_friends.c
@@ -0,0 +1,108 @@
+// Original social-data/SDK adapter. Layout is verified from SDK function semantics,
+// not fixed module addresses or a guessed opaque-object size.
+#include "hle.h"
+#include "nextendo_social.h"
+#include "account_local.h"
+#include "net_socket.h"
+#include "nextendo_account.h"
+#include <stdbool.h>
+#include <string.h>
+#include <stdlib.h>
+
+static bool getter(const char *name,uint32_t instruction) {
+    const uint32_t *code=guest_sym(name); uint32_t words[2]; if (!code) return false;
+    memcpy(words,code,sizeof words); return words[0]==instruction && words[1]==0xd65f03c0u;
+}
+static bool friend_layout(void) {
+    const uint32_t *code=guest_sym("_ZN2nn7friends6FriendC1Ev"); uint32_t words[3]; if (!code) return false;
+    memcpy(words,code,sizeof words);
+    if (words[0]!=0x52804002u && words[1]!=0x52804002u) return false; // constructor memset size 0x200
+    return getter("_ZNK2nn7friends6Friend11GetNicknameEv",0x91006000u) &&
+        getter("_ZNK2nn7friends6Friend11GetPresenceEv",0x91010000u) &&
+        getter("_ZNK2nn7friends6Friend12GetAccountIdEv",0xf9400800u) &&
+        getter("_ZNK2nn7friends6Friend7IsValidEv",0x3944a000u) &&
+        getter("_ZNK2nn7friends6Friend10IsFavoriteEv",0x39448000u);
+}
+static bool presence_layout(void) {
+    const uint32_t *code=guest_sym("_ZN2nn7friends12UserPresenceC1Ev"); if(!code)return false;
+    uint32_t first;memcpy(&first,code,4);
+    if(first==0x52801c02u)return true; // constructor memset size 0xe0
+    // New SDKs inline the complete fourteen-pair zero initialization.
+    if(first!=0xa90d7c1fu)return false;
+    uint32_t words[15];memcpy(words,code,sizeof words);
+    for(unsigned i=0;i<14;i++)if(words[i]!=(0xa9007c1fu|((26-2*i)<<15)))return false;
+    return words[14]==0xd65f03c0u;
+}
+uint32_t dm_nextendo_presence_initialize(void *object,const void *uid) {
+    // Initializing local presence is independent of network authorization.
+    // Publishing it remains an authenticated online operation in Commit.
+    if(!object||!presence_layout())return RES_FAIL;
+    uint8_t local[16];if(!uid){if(!dm_account_copy_uid(local))return RES_FAIL;uid=local;}
+    if(!dm_account_uid_exists(uid))return RES_FAIL;
+    // The original SDK initializer writes only the selected local UID. Its
+    // constructors, Clear, SetDescription and SetAppValue keep their own format.
+    memcpy(object,uid,16);return 0;
+}
+uint32_t dm_nextendo_presence_commit(const void *object) {
+    if(!object||!presence_layout()||!dm_net_nextendo_enabled()||!dm_account_uid_exists(object))return RES_FAIL;
+    return dm_nextendo_social_publish(2,(const uint8_t*)object+0x20,DM_SOCIAL_APP_FIELD);
+}
+static void encode_friend(uint8_t output[0x200],const dm_social_friend *item,const void *uid,bool baas) {
+    memset(output,0,0x200); memcpy(output,uid,16);
+    uint64_t id=baas&&item->nsa?item->nsa:item->pid;
+    memcpy(output+0x10,&id,8); memcpy(output+0x18,item->nickname,33);
+    memcpy(output+0x40,uid,16); memcpy(output+0x50,&item->last_online,8); memcpy(output+0x58,&item->presence,4);
+    output[0x5c]=item->application==strtoull(DM_GAME_ID,NULL,16);
+    memcpy(output+0x60,item->app_field,DM_SOCIAL_APP_FIELD);
+    output[0x120]=item->favorite; output[0x128]=1;
+}
+uint32_t dm_nextendo_friends_ensure(const void *uid) {
+    if (!dm_net_nextendo_enabled() || !dm_account_uid_exists(uid)) return RES_FAIL;
+    dm_social_friend *friends=NULL; size_t count=0;
+    uint32_t result=dm_nextendo_social_friends(&friends,&count); free(friends); return result;
+}
+uint32_t dm_nextendo_friends_available(uint8_t *available,const void *uid) {
+    if (!available || !dm_account_uid_exists(uid)) return RES_FAIL;
+    *available=0;
+    if (!dm_net_nextendo_enabled()) return 0;
+    uint32_t result=dm_nextendo_friends_ensure(uid); if (!result) *available=1; return result;
+}
+uint32_t dm_nextendo_friends_list(int *count,void *output,const void *uid,int offset,int capacity,const void *filter,bool ids_only) {
+    if (count) *count=0;
+    if (!count || !filter || offset<0 || capacity<0 || capacity>DM_SOCIAL_FRIEND_MAX || (capacity&&!output) || !dm_net_nextendo_enabled()) return RES_FAIL;
+    uint8_t local_uid[16];
+    if (!uid) { if (!dm_account_copy_uid(local_uid)) return RES_FAIL; uid=local_uid; }
+    if (!dm_account_uid_exists(uid) || (!ids_only && !friend_layout())) return RES_FAIL;
+    uint8_t options[16]; memcpy(options,filter,sizeof options); uint32_t presence; memcpy(&presence,options,4);
+    if (presence>3 || options[4]>1 || options[5]>1 || options[6] || options[7]) return RES_FAIL;
+    dm_social_friend *friends=NULL; size_t total=0;
+    if (dm_nextendo_social_friends(&friends,&total)) return RES_FAIL;
+    bool baas=dm_nextendo_api_baas_namespace("friends"); size_t matched=0,written=0;
+    for (size_t i=0;i<total;i++) {
+        const dm_social_friend *item=&friends[i];
+        if ((presence==1&&item->presence!=1) || (presence==2&&item->presence!=2) ||
+            (presence==3&&!item->presence) || (options[4]&&!item->favorite) ||
+            (options[5]&&item->application!=strtoull(DM_GAME_ID,NULL,16))) continue;
+        if (matched++<(size_t)offset || written>=(size_t)capacity) continue;
+        if (ids_only) { uint64_t id=baas&&item->nsa?item->nsa:item->pid; memcpy((uint8_t*)output+written*8,&id,8); }
+        else encode_friend((uint8_t*)output+written*0x200,item,uid,baas);
+        written++;
+    }
+    free(friends); *count=(int)written; return 0;
+}
+uint32_t dm_nextendo_friends_update(void *output,const void *uid,const uint64_t *ids,int count) {
+    if (count<0||count>DM_SOCIAL_FRIEND_MAX||(count&&(!output||!ids))||!dm_net_nextendo_enabled()||!dm_account_uid_exists(uid)||!friend_layout())return RES_FAIL;
+    dm_social_friend *friends=NULL;size_t total=0;
+    // UpdateFriendInfo is an explicit refresh, independent of list pagination's
+    // short-lived snapshot. A failed refresh never clears the caller's records.
+    if(dm_nextendo_social_friends_refresh(&friends,&total))return RES_FAIL;
+    size_t selected[DM_SOCIAL_FRIEND_MAX];
+    for(int i=0;i<count;i++){
+        selected[i]=total;
+        for(size_t j=0;j<total;j++)if(friends[j].pid==ids[i]||(friends[j].nsa&&friends[j].nsa==ids[i])){selected[i]=j;break;}
+        if(selected[i]==total){free(friends);return RES_FAIL;}
+    }
+    bool baas=dm_nextendo_api_baas_namespace("friends");
+    for(int i=0;i<count;i++)encode_friend((uint8_t*)output+(size_t)i*0x200,&friends[selected[i]],uid,baas);
+    free(friends);return 0;
+}
diff --git a/dm/host/hle_nextendo_preflight_mac.c b/dm/host/hle_nextendo_preflight_mac.c
new file mode 100644
index 0000000..2bc9daf
--- /dev/null
+++ b/dm/host/hle_nextendo_preflight_mac.c
@@ -0,0 +1,137 @@
+// File-based Keychain UI policy is process-wide. Probe only in another instance
+// of this same executable, before AppKit/guest startup, never in the renderer.
+#include <TargetConditionals.h>
+#if TARGET_OS_OSX
+#include "nextendo_preflight_mac.h"
+#include <dispatch/dispatch.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <mach-o/dyld.h>
+#include <signal.h>
+#include <spawn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/event.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+_Static_assert(sizeof(dm_nextendo_preflight_reply) == 32, "preflight wire size");
+_Static_assert(sizeof(dm_nextendo_preflight_diagnostic) == 16, "preflight diagnostic wire size");
+static _Thread_local dm_nextendo_preflight_status diagnostic;
+dm_nextendo_preflight_status dm_nextendo_preflight_last_status(void) { return diagnostic; }
+static int preflight_failed(int stage, int error) { diagnostic.stage=stage; diagnostic.error=error; return 0; }
+static uint64_t preflight_now(void) {
+    struct timespec now; if (clock_gettime(CLOCK_MONOTONIC, &now)) return 0;
+    return (uint64_t)now.tv_sec * 1000000000 + (uint64_t)now.tv_nsec;
+}
+static pid_t preflight_reap(pid_t child, int *status) { return waitpid(child, status, WNOHANG); }
+static void preflight_reap_cancelled(void *context) {
+    pid_t child = (pid_t)(intptr_t)context;
+    while (waitpid(child, NULL, 0) < 0 && errno == EINTR) {}
+}
+static void preflight_cancel(pid_t child) {
+    int status; pid_t got;
+    do { got = preflight_reap(child, &status); } while (got < 0 && errno == EINTR);
+    // ECHILD means ownership was lost; that numeric PID may already be reused.
+    if (got != 0) return;
+    kill(child, SIGKILL);
+    // Cancellation must not extend the caller's deadline. Only this owned,
+    // unreaped child is handed to a temporary background reaper, with no UI.
+    dispatch_async_f(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), (void *)(intptr_t)child, preflight_reap_cancelled);
+}
+int dm_nextendo_preflight_query(dm_nextendo_preflight_reply *out, unsigned timeout_ms) {
+    diagnostic=(dm_nextendo_preflight_status){.stage=DM_PREFLIGHT_ARGUMENT,.bytes=-1,.exit_code=-1};
+    if (!out) return preflight_failed(DM_PREFLIGHT_ARGUMENT,EINVAL); memset(out, 0, sizeof *out);
+    if (!timeout_ms || timeout_ms > 5000) return preflight_failed(DM_PREFLIGHT_ARGUMENT,EINVAL);
+    char raw[PATH_MAX], executable[PATH_MAX]; uint32_t size = sizeof raw;
+    if (_NSGetExecutablePath(raw, &size)) return preflight_failed(DM_PREFLIGHT_EXECUTABLE,ENAMETOOLONG);
+    if (!realpath(raw, executable)) return preflight_failed(DM_PREFLIGHT_EXECUTABLE,errno);
+    int pair[2]; if (pipe(pair)) return preflight_failed(DM_PREFLIGHT_PIPE,errno);
+    int writer = fcntl(pair[1], F_DUPFD_CLOEXEC, 8); close(pair[1]);
+    if (writer < 0) { int saved=errno; close(pair[0]); return preflight_failed(DM_PREFLIGHT_PIPE,saved); }
+    if (fcntl(pair[0], F_SETFD, FD_CLOEXEC) || fcntl(pair[0], F_SETFL, O_NONBLOCK)) { int saved=errno; close(pair[0]); close(writer); return preflight_failed(DM_PREFLIGHT_PIPE,saved); }
+    int queue = kqueue(); if (queue < 0) { int saved=errno; close(pair[0]); close(writer); return preflight_failed(DM_PREFLIGHT_QUEUE,saved); }
+    posix_spawn_file_actions_t actions; int error = posix_spawn_file_actions_init(&actions);
+    if (error) { close(queue); close(pair[0]); close(writer); return preflight_failed(DM_PREFLIGHT_SPAWN,error); }
+    error = posix_spawn_file_actions_addclose(&actions, pair[0]);
+    if (!error) error = posix_spawn_file_actions_adddup2(&actions, writer, DM_NEXTENDO_PREFLIGHT_FD);
+    if (!error) error = posix_spawn_file_actions_addclose(&actions, writer);
+    for (int fd = 0; fd < 3 && !error; fd++) error = posix_spawn_file_actions_addopen(&actions, fd, "/dev/null", fd ? O_WRONLY : O_RDONLY, 0);
+    posix_spawnattr_t attributes; int initialized = !posix_spawnattr_init(&attributes);
+    if (!initialized && !error) error = EINVAL;
+    if (initialized && !error) error = posix_spawnattr_setflags(&attributes, POSIX_SPAWN_CLOEXEC_DEFAULT);
+    const char *flag=getenv("DM_ACCOUNT_TRACE");int trace=flag && !strcmp(flag,"1");
+    char *arguments[] = {executable, trace ? DM_NEXTENDO_PREFLIGHT_DIAGNOSTIC_ARG : DM_NEXTENDO_PREFLIGHT_ARG, NULL}; pid_t child = -1;
+    uint64_t now = preflight_now(), deadline = now + (uint64_t)timeout_ms * 1000000;
+    if (!now && !error) error = EINVAL;
+    // This is not a renderer launch. In particular, dyld must not run inherited
+    // diagnostic constructors or injected libraries before the helper's main.
+    char *environment[8] = {0}; size_t variables = 0;
+    static const char *keys[] = {"HOME", "TMPDIR", "LANG", "LC_ALL", "LC_CTYPE", "LC_MESSAGES"};
+    for (size_t i = 0; !error && i < sizeof keys / sizeof *keys; i++) {
+        const char *value = getenv(keys[i]);
+        if (value && asprintf(&environment[variables], "%s=%s", keys[i], value) < 0) error = ENOMEM;
+        else if (value) variables++;
+    }
+    // The caller has already gated enabled account services. Give this bounded,
+    // credential-only child the explicit capability: AUTO would disable it
+    // without the parent's deliberately omitted route profile. No routes, game
+    // settings, account values or other DM_* switches enter the child.
+    if (!error && !(environment[variables++] = strdup("DM_NETWORK=nextendo"))) error = ENOMEM;
+    if (!error) error = posix_spawn(&child, executable, &actions, &attributes, arguments, environment);
+    for (size_t i = 0; i < variables; i++) free(environment[i]);
+    if (initialized) posix_spawnattr_destroy(&attributes);
+    posix_spawn_file_actions_destroy(&actions); close(writer);
+    if (error) { close(queue); close(pair[0]); return preflight_failed(DM_PREFLIGHT_SPAWN,error); }
+    struct kevent change;
+    EV_SET(&change, (uintptr_t)pair[0], EVFILT_READ, EV_ADD | EV_CLEAR, 0, 0, NULL);
+    int registered = kevent(queue, &change, 1, NULL, 0, NULL) == 0;
+    diagnostic.stage=registered ? DM_PREFLIGHT_TIMEOUT : DM_PREFLIGHT_REGISTER;
+    diagnostic.error=registered ? 0 : errno;
+    EV_SET(&change, (uintptr_t)child, EVFILT_PROC, EV_ADD | EV_ONESHOT, NOTE_EXIT, 0, NULL);
+    // An already-exited child may reject registration. waitpid and pipe EOF
+    // still establish completion; no PID is signalled merely for this error.
+    (void)kevent(queue, &change, 1, NULL, 0, NULL);
+    size_t expected=sizeof *out+(trace ? sizeof(dm_nextendo_preflight_diagnostic) : 0),capacity=expected+1;
+    uint8_t bytes[sizeof *out + sizeof(dm_nextendo_preflight_diagnostic) + 1]; size_t count = 0; int status = 0, reaped = 0, owned = 1;
+    while (registered) {
+        ssize_t n;
+        do { n = read(pair[0], bytes + count, capacity - count); if (n > 0) count += (size_t)n; } while (n > 0 && count < capacity);
+        if (count == capacity) { diagnostic.stage=DM_PREFLIGHT_PACKET; break; }
+        if (n < 0 && errno != EAGAIN && errno != EINTR) { diagnostic.stage=DM_PREFLIGHT_READ; diagnostic.error=errno; break; }
+        pid_t got = preflight_reap(child, &status);
+        if (got == child) { reaped = 1; owned = 0; break; }
+        if (got < 0 && errno != EINTR) { diagnostic.stage=DM_PREFLIGHT_REAP; diagnostic.error=errno; owned = errno != ECHILD; break; }
+        now = preflight_now(); if (!now || now >= deadline) break;
+        uint64_t left = deadline - now; struct timespec timeout = {(time_t)(left / 1000000000), (long)(left % 1000000000)};
+        struct kevent events[2]; int ready = kevent(queue, NULL, 0, events, 2, &timeout);
+        if (ready < 0 && errno != EINTR) { diagnostic.stage=DM_PREFLIGHT_WAIT; diagnostic.error=errno; break; }
+    }
+    if (owned) preflight_cancel(child);
+    // A child may exit between the first drain and waitpid; take its final
+    // bytes after reaping as well, and reject truncation or trailing payload.
+    if (reaped && count < capacity) {
+        ssize_t n; do { n = read(pair[0], bytes + count, capacity - count); if (n > 0) count += (size_t)n; } while (n > 0 && count < capacity);
+    }
+    close(queue); close(pair[0]);
+    diagnostic.bytes=(int)count;
+    if (!reaped) return 0;
+    diagnostic.exit_code=WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+    diagnostic.signal=WIFSIGNALED(status) ? WTERMSIG(status) : 0;
+    if (!WIFEXITED(status) || WEXITSTATUS(status)) return preflight_failed(DM_PREFLIGHT_EXIT,0);
+    if (count != expected) return preflight_failed(DM_PREFLIGHT_PACKET,0);
+    dm_nextendo_preflight_reply reply; memcpy(&reply, bytes, sizeof reply);
