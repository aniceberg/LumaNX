+    for (NSUInteger i = 0; i < value.length; i++) { unichar c = [value characterAtIndex:i]; if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_')) return nil; }
