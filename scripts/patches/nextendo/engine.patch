+def nextendo_variant(py, repo, exe_dir, patched, work, env, logs, g):
+    """Compile the provider's signed exact-build patches into separate code pages.
+    A fresh signed catalog is mandatory; no patch is applied to offline/LAN code.
+    Unknown builds retain their original main and are reported without guessing.
+    """
+    import nextendo_patches
+    PROG.add(1); PROG.stage('Nextendo game adapter', step='verify signed patch catalog and exact main build')
+    destination = patched / 'nextendo'
+    source = work / 'nextendo-source/main'
+    try:
+        catalog = nextendo_patches.verified_catalog(repo, work / 'nextendo-catalog')
+        applied = nextendo_patches.prepare_nso(exe_dir / 'main', source, g.id.lower(), catalog)
+    except (OSError, ValueError, subprocess.CalledProcessError) as error:
+        raise BuildError('Nextendo game adapter could not be verified; no game code was changed: ' + str(error)) from error
+    if not applied:
+        rmtree(destination)
