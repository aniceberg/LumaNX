+        char *line = cursor, *newline = memchr(cursor, '\n', (size_t)(end - cursor)); if (newline) { *newline = 0; cursor = newline + 1; } else cursor = end;
+        size_t length = strlen(line); if (length && line[length - 1] == '\r') line[--length] = 0;
+        if (!magic) {
