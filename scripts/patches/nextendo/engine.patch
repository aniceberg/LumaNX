+}
+
+static uint32_t friends_snapshot(dm_social_friend **output,size_t *count,bool refresh) { @autoreleasepool {
+    if (count) *count=0; if (output) *output=NULL; if (!output || !count) return DM_ACCOUNT_FAIL;
+    NSData *identity=dm_nextendo_api_identity("friends"); if (!identity) return DM_ACCOUNT_FAIL;
+    static pthread_mutex_t mutex=PTHREAD_MUTEX_INITIALIZER;
+    static NSData *cached_identity,*cached_records; static size_t cached_count; static NSTimeInterval fetched;
+    pthread_mutex_lock(&mutex); NSData *records=nil; size_t n=0;
+    if (!refresh && [identity isEqual:cached_identity] && monotonic_time()-fetched<30) { records=cached_records; n=cached_count; }
+    pthread_mutex_unlock(&mutex);
+    if (!records) {
+        uint8_t *buffer=malloc(1024*1024); if (!buffer) return DM_ACCOUNT_FAIL; size_t length=0;
+        uint32_t result=dm_nextendo_api_request("friends",NULL,0,buffer,1024*1024,&length);
+        NSData *data=result||!length?nil:[NSData dataWithBytes:buffer length:length]; free(buffer);
+        if (data && !(records=decode_friends(data,&n))) social_trace("op=api.friends.records result=invalid");
+        if (records) {
+            const dm_social_friend *item=records.bytes; size_t nsa=0,online=0,same=0; uint64_t title=strtoull(DM_GAME_ID,NULL,16);
+            for (size_t i=0;i<n;i++) { nsa+=item[i].nsa!=0; online+=item[i].presence!=0; same+=item[i].presence&&item[i].application==title; }
+            social_trace("op=api.friends.records count=%zu nsa=%zu online=%zu same_app=%zu",n,nsa,online,same);
+        }
+        if (!data || !records || ![identity isEqual:dm_nextendo_api_identity("friends")]) return DM_ACCOUNT_FAIL;
+        pthread_mutex_lock(&mutex); cached_identity=identity; cached_records=records; cached_count=n; fetched=monotonic_time(); pthread_mutex_unlock(&mutex);
+    }
+    if (![identity isEqual:dm_nextendo_api_identity("friends")]) return DM_ACCOUNT_FAIL;
+    // Every caller owns its snapshot; sign-out/account changes cannot mutate it.
+    if (n) { *output=malloc(records.length); if (!*output) return DM_ACCOUNT_FAIL; memcpy(*output,records.bytes,records.length); }
+    *count=n; return 0;
+} }
+uint32_t dm_nextendo_social_friends(dm_social_friend **output,size_t *count) { return friends_snapshot(output,count,false); }
+uint32_t dm_nextendo_social_friends_refresh(dm_social_friend **output,size_t *count) { return friends_snapshot(output,count,true); }
+
+// This process's presence: playing this game (2) until the game itself declares another state
+// (UserPresence::Commit, an online-play session). The refresh re-sends that latest declared state.
+static pthread_mutex_t presence_mutex=PTHREAD_MUTEX_INITIALIZER;
+static unsigned presence_status=2; static uint8_t presence_field[DM_SOCIAL_APP_FIELD]; static size_t presence_size;
+
+static uint32_t publish_now(unsigned status,const uint8_t *app_field,size_t size) { @autoreleasepool {
+    uint64_t generation=0; NSString *proof=dm_nextendo_api_passive_bearer(&generation);
+    if(!proof)return DM_ACCOUNT_FAIL;
+    NSString *title=[@DM_GAME_ID lowercaseString];
+    id name=[NSBundle.mainBundle objectForInfoDictionaryKey:@"CFBundleDisplayName"];
+    if(![name isKindOfClass:NSString.class]||![name length])name=title;
+    NSData *field=[NSData dataWithBytes:app_field length:size];
+    NSDictionary *object=@{@"status":@(status),@"app_id":title,@"jeu":name,@"app_field":[field base64EncodedStringWithOptions:0],
+        @"plateforme":@"NX Port Studio",@"app_detail":@""};
+    NSData *body=[NSJSONSerialization dataWithJSONObject:object options:0 error:nil];
+    if(!body)return DM_ACCOUNT_FAIL;
+    uint8_t response[4096];size_t count=0;
+    uint32_t result=dm_nextendo_api_request_passive("presence",body.bytes,body.length,response,sizeof response,&count,proof,generation);
+    return !result&&dm_nextendo_api_passive_valid(proof,generation)?0:DM_ACCOUNT_FAIL;
+} }
+uint32_t dm_nextendo_social_publish(unsigned status,const uint8_t *app_field,size_t size) {
+    if(status>2||size>DM_SOCIAL_APP_FIELD||(size&&!app_field))return DM_ACCOUNT_FAIL;
+    pthread_mutex_lock(&presence_mutex);
+    presence_status=status; memset(presence_field,0,sizeof presence_field); if(size)memcpy(presence_field,app_field,size); presence_size=size;
+    pthread_mutex_unlock(&presence_mutex);
+    return publish_now(status,app_field,size);
+}
+
+// A console publishes "playing <game>" for every game, and keeps it fresh; the provider drops a
+// presence older than 90 s. Games that never touch nn::friends::UserPresence (Splatoon 3) were
+// therefore offline to every friend. Until the game signs in, the passive authorization is absent
+// and publish_now fails without a Keychain or provider read; it retries every 10 s, then refreshes
+// every 45 s.
+static void *presence_refresh(void *unused) {
+    (void)unused; unsigned failures=0; bool published=false;
+    for (;;) {
+        sleep(published?45:10);
+        unsigned status; size_t size; uint8_t field[DM_SOCIAL_APP_FIELD];
+        pthread_mutex_lock(&presence_mutex); status=presence_status; size=presence_size; memcpy(field,presence_field,sizeof field); pthread_mutex_unlock(&presence_mutex);
+        uint32_t result=publish_now(status,size?field:NULL,size);
+        if (!result != published || (result && !(failures & (failures + 1)))) social_trace("op=api.presence.refresh status=%u result=0x%x",status,result);
+        published=!result; failures=result?failures+1:0;
+    }
+    return NULL;
+}
+static void presence_refresh_start(void) {
+    pthread_t thread; pthread_attr_t attributes; pthread_attr_init(&attributes); pthread_attr_setdetachstate(&attributes,PTHREAD_CREATE_DETACHED);
+    if (pthread_create(&thread,&attributes,presence_refresh,NULL)) social_trace("op=api.presence.refresh result=no-thread");
+    pthread_attr_destroy(&attributes);
+}
+void dm_nextendo_social_presence_start(void) { static pthread_once_t once=PTHREAD_ONCE_INIT; pthread_once(&once,presence_refresh_start); }
diff --git a/dm/host/hle_nextendo_x509.c b/dm/host/hle_nextendo_x509.c
new file mode 100644
index 0000000..7ab6349
--- /dev/null
+++ b/dm/host/hle_nextendo_x509.c
@@ -0,0 +1,102 @@
+// An alternative verifier for the service's explicit private CA, not public PKI.
+// OpenSSL applies strict X.509 chain, purpose, SAN, strength and current-time checks.
+// Apple public-PKI maximum leaf lifetimes do not define this private CA's lifetime.
+#include "nextendo_x509.h"
+#include <string.h>
+#include <time.h>
+#ifdef DM_OPENSSL_X509
+#include <openssl/x509.h>
+#include <openssl/x509_vfy.h>
+#include <openssl/x509v3.h>
+#include <openssl/err.h>
+
+static bool valid_host(const char *host) {
+    if (!host) return false;
+    size_t length = strnlen(host, 254), label = 0;
+    if (!length || length > 253) return false;
+    for (size_t i = 0; i < length; i++) {
+        unsigned char c = (unsigned char)host[i];
+        if (c == '.') { if (!label || host[i - 1] == '-') return false; label = 0; }
+        else {
+            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                  (c >= '0' && c <= '9') || c == '-') || (!label && c == '-') || ++label > 63) return false;
+        }
+    }
+    return label && host[length - 1] != '-';
+}
+static X509 *certificate(const uint8_t *bytes, size_t size) {
+    if (!bytes || !size || size > 65536) return NULL;
+    const unsigned char *cursor = bytes;
+    X509 *value = d2i_X509(NULL, &cursor, (long)size);
+    if (value && cursor != bytes + size) { X509_free(value); value = NULL; }
+    return value;
+}
+bool dm_nextendo_x509_available(void) { return true; }
+bool dm_nextendo_x509_verify_pin(const char *host, const uint8_t *pin, size_t pin_size,
+                                const uint8_t *bytes, size_t size) {
+    if (!valid_host(host) || !pin || !bytes || !size || size > 65536 || pin_size != size ||
+        CRYPTO_memcmp(pin, bytes, size)) return false;
+    X509 *leaf = certificate(bytes, size); if (!leaf) return false;
+    EVP_PKEY *public_key = X509_get_pubkey(leaf);
+    ASN1_TIME *now = ASN1_TIME_set(NULL, time(NULL));
+    int before = now ? ASN1_TIME_compare(X509_get0_notBefore(leaf), now) : -2;
+    int after = now ? ASN1_TIME_compare(X509_get0_notAfter(leaf), now) : -2;
+    int signature_bits = 0;
+    // The enrolled route supplies identity, rather than an absent SAN. Retain
+    // current-time, server-purpose, strong-key and self-signature checks. TLS
+    // independently proves possession of this exact certificate's private key.
+    bool valid = public_key && EVP_PKEY_security_bits(public_key) >= 112 &&
+        X509_NAME_cmp(X509_get_subject_name(leaf), X509_get_issuer_name(leaf)) == 0 &&
+        before != -2 && before <= 0 && after >= 0 &&
+        X509_check_purpose(leaf, X509_PURPOSE_SSL_SERVER, 0) == 1 &&
+        X509_get_signature_info(leaf, NULL, NULL, &signature_bits, NULL) == 1 && signature_bits >= 112 &&
+        X509_verify(leaf, public_key) == 1;
+    // Some private endpoints serve their self-signed CA-marked certificate
+    // directly. Exact peer-DER equality does not grant it issuer authority:
+    // a different leaf signed by this key still fails the comparison above.
+    ASN1_TIME_free(now); EVP_PKEY_free(public_key); X509_free(leaf); ERR_clear_error();
+    return valid;
+}
+bool dm_nextendo_x509_verify(const char *host, const uint8_t *anchor, size_t anchor_size,
+                            const uint8_t *const *chain, const size_t *sizes, size_t count) {
+    if (!valid_host(host) || !chain || !sizes || !count || count > 16) return false;
+    bool ok = false; size_t total = 0;
+    X509 *root = certificate(anchor, anchor_size), *leaf = NULL;
+    X509_STORE *store = X509_STORE_new();
+    X509_STORE_CTX *context = X509_STORE_CTX_new();
+    STACK_OF(X509) *untrusted = sk_X509_new_null();
+    if (!root || !store || !context || !untrusted || X509_check_ca(root) <= 0 ||
+        X509_check_issued(root, root) != X509_V_OK || X509_STORE_add_cert(store, root) != 1) goto done;
+    for (size_t i = 0; i < count; i++) {
+        if (!sizes[i] || sizes[i] > 65536 || total > 1048576 - sizes[i]) goto done;
+        total += sizes[i]; X509 *item = certificate(chain[i], sizes[i]); if (!item) goto done;
+        if (!i) leaf = item;
+        else if (!sk_X509_push(untrusted, item)) { X509_free(item); goto done; }
+    }
+    if (X509_STORE_CTX_init(context, store, leaf, untrusted) != 1) goto done;
+    X509_VERIFY_PARAM *parameters = X509_STORE_CTX_get0_param(context);
+    if (!parameters || X509_VERIFY_PARAM_set_purpose(parameters, X509_PURPOSE_SSL_SERVER) != 1 ||
+        X509_VERIFY_PARAM_set_flags(parameters, X509_V_FLAG_X509_STRICT | X509_V_FLAG_CHECK_SS_SIGNATURE) != 1 ||
+        X509_VERIFY_PARAM_set1_host(parameters, host, 0) != 1) goto done;
+    X509_VERIFY_PARAM_set_hostflags(parameters, X509_CHECK_FLAG_NEVER_CHECK_SUBJECT | X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS);
+    X509_VERIFY_PARAM_set_auth_level(parameters, 2);
+    X509_VERIFY_PARAM_set_depth(parameters, 12);
+    // No default paths, partial-chain trust, time suppression, custom verify
+    // callback or automatically adopted certificate supplied by the peer.
+    ok = X509_verify_cert(context) == 1;
+done:
+    X509_STORE_CTX_free(context); X509_STORE_free(store); X509_free(root);
+    X509_free(leaf); sk_X509_pop_free(untrusted, X509_free); ERR_clear_error();
+    return ok;
+}
+#else
+bool dm_nextendo_x509_available(void) { return false; }
+bool dm_nextendo_x509_verify_pin(const char *host, const uint8_t *pin, size_t pin_size,
+                                const uint8_t *leaf, size_t leaf_size) {
+    (void)host; (void)pin; (void)pin_size; (void)leaf; (void)leaf_size; return false;
+}
+bool dm_nextendo_x509_verify(const char *host, const uint8_t *anchor, size_t anchor_size,
+                            const uint8_t *const *chain, const size_t *sizes, size_t count) {
+    (void)host; (void)anchor; (void)anchor_size; (void)chain; (void)sizes; (void)count; return false;
+}
+#endif
